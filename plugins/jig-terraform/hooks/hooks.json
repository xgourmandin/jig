{
  "description": "Jig Terraform hooks: format and lint every edited .tf file",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tf-post-edit.sh\"", "timeout": 120 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-tools.sh\"", "timeout": 15 }
        ]
      }
    ]
  }
}
